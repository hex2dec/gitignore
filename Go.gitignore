# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Visual Studio Code
# .vscode/

# Zed Editor
# .zed/

# JetBrains IDEs (WebStorm / GoLand / IntelliJ IDEA / PyCharm / RustRover)
# .idea/

# AI coding tools
# Ignore the contents, not the directory itself: git cannot re-include a path
# whose parent directory is excluded, so `!.claude/skills/` requires `.claude/*`.
# Team-shared config is re-included below; local state (`settings.local.json`,
# `plans/`, `sessions/`, `shell-snapshots/`, ...) stays ignored.
.claude/*
!.claude/settings.json
!.claude/commands/
!.claude/agents/
!.claude/skills/
.codebuddy/*
!.codebuddy/settings.json
!.codebuddy/commands/
!.codebuddy/agents/
!.codebuddy/skills/
.workbuddy/*
!.workbuddy/settings.json
!.workbuddy/commands/
!.workbuddy/agents/
!.workbuddy/skills/

# Personal memory overrides (e.g. CLAUDE.local.md, CODEBUDDY.local.md,
# WORKBUDDY.local.md); the shared CLAUDE.md / CODEBUDDY.md / WORKBUDDY.md stay tracked
*.local.md

# ------------------------------------------------------------------------------
# Go
# ------------------------------------------------------------------------------

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
